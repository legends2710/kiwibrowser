# Kiwi Browser Android 15 ARM64 RELEASE Build Configuration
# Optimized for production release with Android 15 specific settings

target_os = "android"
target_cpu = "arm64"
is_debug = false
is_java_debug = false

# Android 15 Release Configuration
android_api_level = 35
android_channel = "stable"

# Release Build Settings
is_official_build = true
is_component_build = false
is_chrome_branded = false
is_clang = true
symbol_level = 1
exclude_unwind_tables = false

# Version Settings for Release
use_unofficial_version_number = false
android_default_version_code = "1"
android_keystore_name = "release"
android_keystore_password = "public_password"
android_keystore_path = "../../keystore.jks"
android_default_version_name = "105.0.5195.33"

# Performance and Testing
fieldtrial_testing_like_official_build = true
icu_use_data_file = false
enable_iterator_debugging = false

# API Keys (Kiwi Browser specific)
google_api_key = "KIWIBROWSER"
google_default_client_id = "42.apps.kiwibrowser.com"
google_default_client_secret = "KIWIBROWSER_NOT_SO_SECRET"
use_official_google_api_keys = false

# Media and Codec Support
ffmpeg_branding = "Chrome"
proprietary_codecs = true
enable_nacl = false
enable_widevine = true
enable_mse_mpeg2ts_stream_parser = true
enable_remoting = false
rtc_use_h264 = false

# V8 JavaScript Engine
v8_use_external_startup_data = true
update_android_aar_prebuilts = true

# Kiwi Browser Features
enable_extensions = true
enable_pdf = false
enable_plugins = false

# Build Optimizations
disable_android_lint = true
treat_warnings_as_errors = false
cc_wrapper = "ccache"

# Android 15 SDK/NDK paths
android_ndk_root = "/home/erick/android-tools/android-sdk/ndk/26.1.10909125"
android_sdk_root = "/home/erick/android-tools/android-sdk"

# Release Optimizations
enable_resource_allowlist_generation = false
dfmify_dev_ui = false
enable_reporting = true
safe_browsing_mode = 1